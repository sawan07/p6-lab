{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IngressTransactionPayload",
  "type": "object",
  "required": [
    "transactionId",
    "originatingUiId",
    "timestamp",
    "payloadHash",
    "payloadData"
  ],
  "properties": {
    "transactionId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique system-wide transactional correlation ID for tracing."
    },
    "originatingUiId": {
      "type": "string",
      "enum": ["UI_01", "UI_02", "UI_03", "UI_04", "UI_05"],
      "description": "The specific client user interface executing the transaction call."
    },
    "timestamp": {
      "type": "integer",
      "description": "Unix epoch millisecond timestamp recorded at edge ingress."
    },
    "payloadHash": {
      "type": "string",
      "description": "SHA-256 integrity token generated by the Client-Side Idempotency Engine."
    },
    "payloadData": {
      "type": "object",
      "required": ["userId", "operationType", "idempotencyKey"],
      "properties": {
        "userId": { "type": "string" },
        "operationType": { "type": "string", "enum": ["WRITE_MUTATION", "BATCH_SYNC"] },
        "idempotencyKey": { "type": "string" }
      }
    }
  }
}
